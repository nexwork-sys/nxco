# Copy this file to .env and fill in real values before running.

# ---- PostgreSQL ---------------------------------------------------------------
# On Render: create a PostgreSQL service, then paste its "Internal Database URL" here
# (use the External URL only when running from your own PC, and then set DB_SSL=true).
# DATABASE_URL=postgresql://user:password@host:5432/nxco
# Or separate values (local development):
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=nxco
# true for Render's External URL / any host that requires SSL. Internal URL: false.
DB_SSL=false

# ---- Cloudinary (image storage) --------------------------------------------
# Dashboard > Settings > API Keys. Either the single URL...
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
# ...or the three values:
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Root folder inside your Cloudinary media library
CLOUDINARY_FOLDER=nxco

# ---- App -------------------------------------------------------------------
# Secret used to sign JWTs — use a long random string in production
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=30d
PORT=4000
# Shown as the header on generated order invoices (PDF)
COMPANY_NAME=NXCO
# Comma-separated list of origins allowed to call this API
CORS_ORIGINS=*
